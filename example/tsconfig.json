{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "preserveSymlinks": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "convex": ["node_modules/convex/dist/esm-types/index.d.ts"],
      "convex/server": ["node_modules/convex/dist/esm-types/server/index.d.ts"],
      "convex/values": ["node_modules/convex/dist/esm-types/values/index.d.ts"]
    },
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
